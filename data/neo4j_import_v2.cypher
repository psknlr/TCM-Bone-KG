MATCH (a:ModernClinicalAnchor {name:'Vertebral fragility fracture'}), (b:ModernClinicalAnchor {name:'Vertebral fracture assessment'}) MERGE (a)-[e:RISK_ASSESSED_BY {zh:'risk_assessed_by'}]->(b) SET e.edge_class='structural', e.TEC=0.0000, e.mapping_score=0.0000;
