CREATE CONSTRAINT IF NOT EXISTS FOR (n:Book) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Dynasty) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:TcmDisease) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Syndrome) REQUIRE n.name IS UNIQUE;
